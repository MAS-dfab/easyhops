                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from writehops import HOPSWriter, FrenchRidgeProcess, DoubleCutProcess, TextProcess
from parse_btlx import BTLXParser
from compas_rhino import unload_modules
import math
from compas_rhino.conversions import frame_to_rhino, point_to_rhino

from compas.geometry import Transformation, Frame, Point, Plane, Rotation, angle_vectors_signed, Vector, angle_vectors

from compas.rpc import Proxy
from compas.geometry import Box

import Rhino.Geometry as rg
import os

from copy import deepcopy

unload_modules("writehops")
unload_modules("parse_btlx")

file_path = os.path.join(os.path.dirname(ghenv.Component.OnPingDocument().FilePath), "Module_44_test.btlx")
parser = BTLXParser(file_path)
remachining_dict = parser.get_remachining_dict()
text_dict = parser.get_text_dict()

keys = [key for key, value in remachining_dict.items()]

index = keys[index]
#print index
#print(remachining_dict)
length = remachining_dict[str(index)]["length"]
hopper = HOPSWriter(length)
processes = []
geo = []
box = Box.from_corner_corner_height([0,0,0], [length, 60,0], 60)
print remachining_dict[str(index)]
text =  text_dict[str(index)]["text"][0]
for machining in remachining_dict[str(index)]["machinings"]:
    if machining["Name"] == "French ridge lap":
        process = FrenchRidgeProcess(hopper, machining["face_front"], machining["ReferencePlaneID"])
    elif machining["Name"] == "T-Butt Joint":
        process = DoubleCutProcess(hopper, machining)
    print process.ref_orientation
    text_process = TextProcess(process.hopper, text, process.ref_orientation)
    text_frame = frame_to_rhino(text_process.frame)
    text_text = text_process.text
    ref =frame_to_rhino(text_process.ref_frame)
    processes.append(process)
    geo.extend([process.frame1, process.frame2])
hopper.generate_hops(processes)

rg = []
for f in geo:
    if isinstance(f, Frame):
        rg.append(frame_to_rhino(f))
    else:
        for frame in f:
            rg.append(frame_to_rhino(frame))
    #create folder with btlx name
#    filename = os.path.join(os.path.dirname(__file__),"hops", "%s_.hop" % str(index))
</item>
