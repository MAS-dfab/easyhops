            <chunk name="Object" index="6">
              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">410755b1-224a-4c1e-a407-bf32fb45ea7e</item>
                <item name="Lib" type_name="gh_guid" type_code="9">00000000-0000-0000-0000-000000000000</item>
                <item name="Name" type_name="gh_string" type_code="10">GhPython Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas.geometry import Frame, Point, Transformation
import math
fr = Frame.worldXY()
fr.rotate(-math.pi/2, fr.xaxis, fr.point)
T = Transformation.from_change_of_basis(Frame.worldXY(), fr)
fr.point = Point(590.10, 46.53, 0).transformed(T)
fr.rotate(math.radians(x), fr.zaxis, fr.point)
fr.rotate(math.radians(y), fr.xaxis, fr.point)
R = Transformation.from_frame(fr).rotation
print fr.euler_angles()
print [math.degrees(a) for a in fr.euler_angles()]
theta_z = math.atan2(R[1, 0], R[0, 0])
print math.degrees(theta_z)
frr = Frame.worldXY()
frr.rotate(-math.pi/2, frr.xaxis, frr.point)
frr.point = Point(590.10, 46.53, 0).transformed(T)
frr.rotate(math.radians(z), frr.zaxis, frr.point)
frr.rotate(math.radians(u), frr.xaxis, frr.point)

from compas_rhino.conversions import frame_to_rhino

a = frame_to_rhino(fr)
b = frame_to_rhino(frr)</item>
