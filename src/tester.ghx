                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from writehops import HOPSWriter, FrenchRidgeProcess, DoubleCutProcess
from compas_rhino import unload_modules
import math
from compas_rhino.conversions import frame_to_rhino, point_to_rhino

from compas.geometry import Transformation, Frame, Point, Plane, Rotation, angle_vectors_signed, Vector, angle_vectors

import Rhino.Geometry as rg
from copy import deepcopy
unload_modules("writehops")
#
#{'ReferencePlaneID': '1', 'Orientation': 'end', 'StartX': '604.799', 'StartY': '29.624', 'Angle1': '59.333', 
#'Inclination1': '138.515', 'Angle2': '154.003', 'Inclination2': '94.118'}

hopper = HOPSWriter(760.0)
process =  DoubleCutProcess(
            hopper,
            {'Name': 'T-Butt Joint', 'Priority': '0', 'Process': 'yes', 'ProcessID': '0', 'ReferencePlaneID': '1', 'Orientation': 'end', 'StartX': '604.799', 'StartY': '29.624', 'Angle1': '59.333', 'Inclination1': '138.515', 'Angle2': '154.003', 'Inclination2': '94.118'},
        )

a = [frame_to_rhino(f) for f in [process.frame1, process.frame2]]

#xx = process.ref_faces[1]
#T = Transformation.from_change_of_basis(xx, Frame.worldXY())
#xx.point = Point(590.10, 46.53, 0.0).transformed(T)
#
#xx.rotate(math.radians(-process.angle1), xx.zaxis, xx.point)
#xx.rotate(math.radians(process.inclination1), xx.xaxis, xx.point)
#c = [frame_to_rhino(xx)]


#c = Frame(Point(process.startx,0,process.starty), [1,0,0], [0,1,0])
#target_normal = -process.frame1.zaxis
#alpha = math.atan2(target_normal.y, target_normal.x)  - math.pi / 2
#c.rotate(alpha, c.zaxis, c.point)
## Angle to rotate around the x-axis to align the normal vector with the z-axis
#beta = angle_vectors_signed([0,0,1], target_normal, c.xaxis)
## Convert angles from radians to degrees for better interpretability (optional)
#alpha_deg = math.degrees(alpha)
#beta_deg = math.degrees(beta)
#print alpha_deg, beta_deg
#c.rotate(beta, c.xaxis, c.point)
#c = frame_to_rhino(process.ref_plane)
#
#e = Frame(Point(process.startx,0,0), [1,0,0], [0,1,0])
#
#target_normal = process.frame2.zaxis
#alpha = math.atan2(target_normal.y, target_normal.x)  + math.pi + math.pi/2
## Angle to rotate around the x-axis to align the normal vector with the z-axis
##e.rotate(alpha, e.zaxis, e.point)
#beta = angle_vectors_signed([0,0,1], target_normal,  e.xaxis)
## Convert angles from radians to degrees for better interpretability (optional)
##e.rotate(beta, e.xaxis, e.point)
#
#alpha_deg = math.degrees(alpha)
#beta_deg = math.degrees(beta)
#print alpha_deg, beta_deg
d = frame_to_rhino(process.cf1)
e = frame_to_rhino(process.cf2)
c = [frame_to_rhino(f) for f in process.ref_faces]
print process.params

b = [rg.Point3d(*p.__data__) for p in process.pts]
#</item>
