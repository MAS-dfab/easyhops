                    <item name="CodeInput" type_name="gh_string" type_code="10">import rhinoscriptsyntax as rs
import Rhino.Geometry as rg
import math

width = 60

# First Part Points
points_part1 = [
    (-175.232, 59.205, -58.4),
    (0, width/2, 0),
    (width, width/3, 0),
    (235.232, -9.205, 0)
]

# Second Part Points
points_part2 = [
    (127.303, -123.908, 0),
    (3.395, -251.211, 0),
    (-39.031, -294.8, 0),
    (-162.939, -422.103, 0),
]

beta, theta = 225, 13.263
plane = rg.Plane(rg.Point3d(875.036,-170.235,89.189), rg.Vector3d.XAxis, rg.Vector3d.YAxis)
plane.Rotate(math.radians(beta), plane.ZAxis, plane.Origin)
plane.Rotate(math.radians(theta), plane.XAxis, plane.Origin)

T = rg.Transform.ChangeBasis(plane, rg.Plane.WorldXY)

rhino_points_part1 = [rg.Point3d(*pt) for pt in points_part1]
rhino_points_part2 = [rg.Point3d(*pt) for pt in points_part2]


[pt.Transform(T) for pt in rhino_points_part2]
# Create points in Rhino

</item>
