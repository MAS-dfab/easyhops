                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from writehops import HOPSWriter, HOPSMerger, FrenchRidgeProcess, DoubleCutProcess, TextProcess, DoubleCutStepJointProcess
from parse_btlx import BTLXParser
from compas_rhino import unload_modules
import math
from compas_rhino.conversions import frame_to_rhino, point_to_rhino, line_to_rhino

from compas.geometry import Transformation, Frame, Point, Plane, Rotation, angle_vectors_signed, Vector, angle_vectors
from compas.geometry import Box, Line

import Rhino.Geometry as rg
import Grasshopper as gh
import os

from copy import deepcopy

unload_modules("writehops")
unload_modules("parse_btlx")

# Get the path to the current Grasshopper file
current_gh_file_path = ghenv.Component.OnPingDocument().FilePath

# Ensure the current file path is valid
if current_gh_file_path:
    # Get the directory of the current Grasshopper file
    current_directory = os.path.dirname(current_gh_file_path)
    
    # Get the base directory (mas-t2-2324)
    base_directory = os.path.abspath(os.path.join(current_directory, '..', '..', 'mas-t2-2324'))
    
    # Define the new subdirectory relative path
    new_subdir = os.path.join('production', 'fabrication')
    
    # Construct the absolute path to the new directory
    new_path = os.path.join(base_directory, new_subdir)
    
    # Construct the folder and file name based on the integer index
    module_folder = "Module_{0}".format(module)
    module_btlx = "Module_{0}.btlx".format(module)
    
    # Construct the full path to the BTLx file, including the 'btlx' subdirectory
    btlx_file_path = os.path.join(new_path, module_folder, 'btlx', module_btlx)
#    btlx_file_path = os.path.join(current_directory, 'stepjoint.btlx')
    hops_file_path = os.path.join(new_path, module_folder, 'btlx',module_folder)
    print(hops_file_path)
    # Print the constructed path
    
    # Check if the BTLx file exists
    if not os.path.isfile(btlx_file_path):
        print("The BTLx file '{0}' does not exist in the folder '{1}'.".format(module_btlx, os.path.join(new_path, module_folder, 'btlx')))
    else:
        print("The BTLx file path is correct.")
else:
    print("The Grasshopper file has not been saved yet. Please save it first.")


parser = BTLXParser(btlx_file_path)
remachining_dict = parser.get_remachining_dict()
text_dict = parser.get_text_dict()

keys = [key for key, value in remachining_dict.items()]

index = keys[index]
ID = "BeamID: " + str(index)

length = remachining_dict[str(index)]["length"]


hopper = HOPSWriter(length)
merger = HOPSMerger()
processes = []
geo = []
lines = []
Blank = Box.from_corner_corner_height([0,0,0], [length, 60,0], 60)
if len(text_dict[str(index)]["text"])&gt;0:
    text =  text_dict[str(index)]["text"][0]
else:
    text = None
for machining in remachining_dict[str(index)]["machinings"]:
    if machining["Name"] == "French ridge lap":
        process = FrenchRidgeProcess(hopper, machining["face_front"], machining["ReferencePlaneID"])
        p = "frl"
    elif machining["Name"] == "T-Butt Joint":
        p = "dc"
        process = DoubleCutProcess(hopper, machining)
    elif machining["Name"] == "TStepJoint":
        p = "dcs"
        process = DoubleCutStepJointProcess(hopper, machining)
    if text:
        text_process = TextProcess(process.hopper, text, process.ref_orientation)
        text_frame = frame_to_rhino(text_process.frame)
        text_text = text_process.text
        ref =frame_to_rhino(text_process.ref_frame)
    processes.append(process)
    if p == "dc":
        geo.extend([process.cf1, process.cf2])
        lines.append(line_to_rhino(Line(*process.pts[:2])))
        lines.append(line_to_rhino(Line(*process.pts[2:])))
    elif p == "frl":
        geo.extend([process.frame1, process.frame2])
    elif p == "dcs":
        lines.append(line_to_rhino(Line(*process.pts[:2])))
        lines.append(line_to_rhino(Line(*process.pts[2:])))
    print process.params
hopper.generate_hops(processes)

Planes = []
for f in geo:
    if isinstance(f, Frame):
        Planes.append(frame_to_rhino(f))
    else:
        for frame in f:
            Planes.append(frame_to_rhino(frame))
#create folder with btlx name
filename = os.path.join(hops_file_path, "%s_.hop" % str(index).zfill(2))
print(filename)
if Write:
    hopper.write_to_file(file_path=filename)
    merger.merge_fabrication_files(hops_file_path, index)

#counter
if "count" not in globals() or Reset:
    count = 0
if Write and not Reset:
    count +=1
Counter = "NewHopFiles: " + str(count) + "/" + str(len(keys))</item>
