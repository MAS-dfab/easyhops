                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import Rhino.Geometry as rg
from copy import deepcopy
import math

# Define your variables (length, leadout, width)
length = 760
leadout = 200
width = 60

# Initialize face_front variable as per the condition



# Set up the plane and points
if face_front:
    if end:
        plane_pt = rg.Point3d(length, 0, width / 2)
    else:
        plane_pt = rg.Point3d(0, 0, width / 2)
    plane = rg.Plane(plane_pt, rg.Vector3d.XAxis, rg.Vector3d.YAxis)
    beta, theta = -45, 13.263
    beta = beta if end else 45
    plane.Rotate(math.radians(beta), plane.ZAxis, plane.Origin)
    plane.Rotate(math.radians(theta), plane.XAxis, plane.Origin)
    if end:
        point1 = rg.Point3d(length - width, 0, width / 3)
        point2 = rg.Point3d(length - width, width, width / 2)
    else:
        point1 = rg.Point3d(width, 0, width / 3)
        point2 = rg.Point3d(width, width, width / 2)
else:
    if end:
        plane_pt = rg.Point3d(length, width, width / 2)
    else:
        plane_pt = rg.Point3d(0, width, width / 2)
        print "11"
    plane = rg.Plane(plane_pt, rg.Vector3d.XAxis, rg.Vector3d.YAxis)
    beta, theta = 135, 13.263
    beta = beta if end else 45
    plane.Rotate(math.radians(beta), plane.ZAxis, plane.Origin)
    plane.Rotate(math.radians(theta), plane.YAxis, plane.Origin)
    if end:
        point1 = rg.Point3d(length - width, 0, width / 2)
        point2 = rg.Point3d(length - width, width, width / 3)
    else:
        point1 = rg.Point3d(width, 0, width / 2)
        point2 = rg.Point3d(width, width, width / 3)

# Calculate vector and transformation
vec = plane_pt-point1
vec.Unitize()
vec = vec*leadout
Tr = rg.Transform.Translation(vec)

# Apply transformations to points
point11 = deepcopy(point1)
point11.Transform(Tr)
point21 = deepcopy(point2)
point21.Transform(Tr)

#T = rg.Transform.ChangeBasis(rg.Plane.WorldXY, plane)
#
#point1.Transform(T)
#point2.Transform(T)
#point11.Transform(T)
#point21.Transform(T)

# Collect points
points = [point11, point1, point2, point21]

# Format the points for CNC output
formatted_points = []
for pt in points:
    formatted_points.append("G01({:.3f},{:.3f},{:.3f},0,0,2)".format(pt.X, pt.Y, pt.Z))

# Define the free plane with origin and beta/theta values
plane_origin = plane_pt
plane_origin_str = "EBENEF({:.3f},{:.3f},{:.3f},{},{},0,0)".format(plane_origin.X, plane_origin.Y, plane_origin.Z, theta, beta)

# Combine the formatted output
output = "; Free Plane Definition\n" + plane_origin_str + "\n; Points\n" + "\n".join(formatted_points)

print(output)
</item>
