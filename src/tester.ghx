                <item name="Lib" type_name="gh_guid" type_code="9">00000000-0000-0000-0000-000000000000</item>
                <item name="Name" type_name="gh_string" type_code="10">GhPython Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import Grasshopper.Kernel as gh
import scriptcontext as sc

# Define a unique key for the counter in the Grasshopper document's sticky dictionary
counter_key = 'ghpython_counter'

# Check if the counter exists in the sticky dictionary
if counter_key not in sc.sticky or reset:
    # Increment the counter by one
    sc.sticky[counter_key] = -1
else:
    # Initialize the counter if it doesn't exist
    sc.sticky[counter_key] += 1

# Output the current value of the counter
counter = sc.sticky[counter_key]

# Set the output
count = counter
</item>
                    <item name="Description" type_name="gh_string" type_code="10">GhPython provides a Python script component</item>
