G01 (EX2+Falz_B,EY2+Falz_B,0,0,ESXY2,2)
G01 (EX2 + Falz_B,EY2 + Falz_B,Falz_H,0,ESXY2,1)
G01 (EX2,EY2,0,0,ESXY2,2)
