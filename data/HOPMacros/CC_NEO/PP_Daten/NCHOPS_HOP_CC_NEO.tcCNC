elseif $CLAMEXWV$=270
;HH_Cabineo FLAECHE kante3 HI
CALL CABINEO_HH ( VAL POS_X:=$X$,POS_Y:=0,TIEFE:=-$T$,SEITE:=3,TYP:=0,WINKEL:=0,FLAECHE:=0)

else
;HH_Cabineo FLAECHE rotation
CALL CABINEO_HH ( VAL POS_X:=$X$,POS_Y:=$Y$,TIEFE:=-$T$,SEITE:=1,TYP:=0,WINKEL:=0,FLAECHE:=0)
</HoleV_HH_Cabineo>

