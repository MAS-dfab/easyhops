\\Ab Campus V7.6.8.49 inkl. ExtsetupV7.exe (V7.21.6)														 
<Para>
Ext=hop
Sort=0
LR=0
Offset=1
\\LogFile=HH_WAREHOUSE

\\Bei negativem Winkel wird ein 2 CNC Programm für Clamex erzeugt. MitrePositiv=1 
\\MitrePositiv=1		   
</Para>

\\WZGV & MASCHINE anpassen
<Header>
;BILD=$cncName$.WMF
;INFO=$cncName$
;WZGV=DIREKT_DEMO
;MASCHINE=DIREKT_DEMO
;NCNAME=TrunCAD20XX
;DX=0
;DY=0
;DZ=0
;DIALOGDLL=Dialoge.DLL
;DIALOGPROC=StandardFormAnzeigen
VARS
_wl := $WL$;winkel links
_wr := $WR$;winkel rechts
_wv := $WV$;winkel vorn
_wh := $WH$;winkel hinten
_Material := '$MAT$';Material
_Werkstoff := '$MATTYP$';P=Platte, M=Massiv, Z=Sonstiges
_KanteDickeRechts := $KRD$;Kantedicke rechts
_KanteDickeLinks := $KLD$;Kantedicke links
_KanteDickeVorne := $KVD$;Kantedicke vorne
_KanteDickeHinten := $KHD$;Kantedicke hinten
_KanteRechts := '$KR$';Kante rechts
_KanteLinks := '$KL$';Kante links
_KanteVorne := '$KV$';Kante vorne
_KanteHinten := '$KH$';Kante hinten
_Teiletyp := '$NAME$';Name des Bauteils
_Anschlag := $NOCHNICHTDA$;Anschlag
_FrontTeilGedreht := $NOCHNICHTDA$;Frontteil gedreht
_TeilGedreht := $NOCHNICHTDA$;Teil gedreht
_lx := $PL$;Länge
_ly := $PB$;Breite
_lz := $PD$;Dicke
_ZugabeL := $LPlus$;Zugabemass Länge
_ZugabeB := $BPlus$;Zugabemass Breite
_Format := $NOCHNICHTDA$;Formatiert j/n
_Name := '$NOCHNICHTDA$';eindeutiger Teilename
_BereichName := '$NOCHNICHTDA$';BereichName
_nest := $NOCHNICHTDA$;Nesting 1/0
_NCNAME := '$cncName$';NCName
DX := $PL$;*VAR*Dimension X
DY := $PB$;*VAR*Dimension Y
DZ := $PD$;*VAR*Dimension Z
_hhdata_Material := '$MAT$';*VAR*Part material / Werkstückmaterialbezeichnung
_HHDATA_EDGEDIMRIGHT := $KRD$;*VAR*edge thickness right / Kantenstärke rechts
_HHDATA_EDGEDIMLEFT := $KLD$;*VAR*edge thickness left / Kantenstärke links
_HHDATA_EDGEDIMFRONT := $KVD$;*VAR*edge thickness front / Kantenstärke vorne
_HHDATA_EDGEDIMBACK := $KHD$;*VAR*edge thickness back / Kantenstärke hinten
_HHDATA_EDGEMATRIGHT := '$KR$';*VAR*edge type right / Kantentyp rechts
_HHDATA_EDGEMATLEFT := '$KL$';*VAR*edge type left / Kantentyp links
_HHDATA_EDGEMATFRONT := '$KV$';*VAR*edge type front / Kantentyp vorne
_HHDATA_EDGEMATBACK := '$KH$';*VAR*edge type back / Kantentyp hinten
_HHDATA_EDGEPRGRIGHT := $NOCHNICHTDA$;*VAR*edge program right / Kantenprogramm rechts
_HHDATA_EDGEPRGLEFT := $NOCHNICHTDA$;*VAR*edge program left / Kantenprogramm links
_HHDATA_EDGEPRGFRONT := $NOCHNICHTDA$;*VAR*edge program front / Kantenprogramm vorne
_HHDATA_EDGEPRGBACK := $NOCHNICHTDA$;*VAR*edge program back / Kantenprogramm hinten
_HHDATA_NESTGRAINDIRECTION := $MATGRAIN$;Grain direction / Faserrichtung
_HHDATA_NESTMIRROR := $NOCHNICHTDA$;Mirror / Spiegeln
_hhdata_NestStepAngle := $MATROT$;StepAngle / Schrittwinkel
_HHDATA_NESTRECTANGLE := $NOCHNICHTDA$;Rectangle / Rechteckig
_HHDATA_NESTTOPBOTTOMSIDE := $NOCHNICHTDA$;Top/Bottom Side / OberUnterSeite
_HHDATA_ORDERTEXT1 := '$NOCHNICHTDA$';*VAR*Commission / Kommission
_HHDATA_ORDERTEXT2 := '$NOCHNICHTDA$';*VAR*Customername / Kundenname
_HHDATA_INFO := '$NOCHNICHTDA$';*VAR*Infos / Infos
_HHDATA_FREETEXT1 := '$NOCHNICHTDA$';*VAR*Korpusname / Korpusname
_HHDATA_TYPE := '$NAME$';*VAR*Partname / Teilname
_HHDATA_TYPE := '$CNCNAME$';*VAR*Filename / Dateiname
_format01 := '$NOCHNICHTDA$';*VAR*Formated / Formatiert
_Horizontal := '$NOCHNICHTDA$';*VAR*Horizontal / Horizontal
_ClamexBohrung := '$NOCHNICHTDA$';*VAR*Clamexbohrung j/n / Hole for Clamex y/n
_HOPFile2 := '$NOCHNICHTDA$';*VAR*Zweite hop-Datei/second hop-file
_HHDATA_Bitmuster :=$HHBITMUSTER$ 
START
</Header>

<Part>
\\HH_Version_2020.1
CALL PART_HH ( VAL L:=$PL$,B:=$PB$,D:=$PD$)
</Part>

<StartCNC>


</StartCNC>

<StartPart>

</StartPart>

<EndPart>
CALL ENDE_HH ()
</EndPart>

<EndCNC>
</EndCNC>

<Routing>
</Routing>

<Startcontour>
KB ('$KID$_Kontur','',$X$,$Y$,-2,'',1,1)
</Startcontour>

<Line>
KG01 ('',$X$,$Y$,-2,'',1,1)
</Line>

<ArcCW>
KG02M('',$X$,$Y$,-2,$CRX$,$CRY$,'',1,2,1)
</ArcCW>

<ArcCWmax>
KG02M('',$X$,$Y$,-2,$CRX$,$CRY$,'',1,2,1)
</ArcCWmax>

<ArcCCW>
KG03M('',$X$,$Y$,-2,$CRX$,$CRY$,'',1,2,1)
</ArcCCW>

<ArcCCWmax>
KG03M('',$X$,$Y$,-2,$CRX$,$CRY$,'',1,2,1)
</ArcCCWmax>

<Line>
</Line>

<ArcCW>
</ArcCW>

<ArcCWmax>
</ArcCWmax>

<ArcCCW>
</ArcCCW>

<ArcCCWmax>
</ArcCCWmax>

<CloseContour>
</CloseContour>

\\Steuerung der Tiefe
<Endcontour>
CALL CONTURMILLING_HH ()
if  $WL$<>0 | $WR$<>0
;Angel SAW links rechts
CALL ANGLE_SAW_HH ()

\\ noch keine Funktion---------------
elseif $WV$<>0 | $WH$<>0
;Angel SAW vorne hinten
CALL ANGLE_SAW_HH ()
else
</Endcontour>

<PocketFreeStartContour>
</PocketFreeStartContour>

<PocketFree>
</PocketFree>


<HoleV>
\\Lochreihe in x+
if $LRX$=1 & $LRAN$>1
WZB (501,_VE,_V,_VA,_SD,_ANF,'1')
CALL _Rbohx_einpass_V5 ( VAL EINPASSEN:=0,SPX:=$X$,SPY:=$Y$,SPY2:=$Y$,RASTER:=$LRAB$,EPX:=$X$+(($LRAN$-1)*$LRAB$),T:=-$T$,D:=$DIA$,TLF:=30,ESXY:=1,ESX:=1,ESY:=3,ESD:=0,USE2:=0)

\\Lochreihe in x-
elseif $LRX$=-1 & $LRAN$>1
WZB (501,_VE,_V,_VA,_SD,_ANF,'1')
CALL _Rbohx_einpass_V5 ( VAL EINPASSEN:=0,SPX:=$X$,SPY:=$Y$,SPY2:=$Y$,RASTER:=-$LRAB$,EPX:=$X$+(($LRAN$-1)*-$LRAB$),T:=-$T$,D:=$DIA$,TLF:=10,ESXY:=1,ESX:=1,ESY:=3,ESD:=0,USE2:=0)

elseif $DIA$=15
\\bohren 15mm Topfbandbohrer
;15mm
CALL DRILL_V_HH ( VAL X:=$X$,Y:=$Y$,D:=$DIA$,T:=-$T$,TLF:=30,AXISDW:=0)

elseif $DIA$=35
\\bohren 35mm Topfbandbohrer
;35mm
CALL DRILL_V_HH ( VAL X:=$X$,Y:=$Y$,D:=$DIA$,T:=-$T$,TLF:=30,AXISDW:=0)


else
\\bohren
CALL DRILL_V_HH ( VAL X:=$X$,Y:=$Y$,D:=$DIA$,T:=-$T$,TLF:=10,AXISDW:=0)
</HoleV>



\\HH_Cabineo Standart Bohren oder Fräsen
<HoleV_HH_Cabineo>
if $DIA$=5
\\bohren
;Cabineo 5mm
CALL DRILL_V_HH ( VAL X:=$X$,Y:=$Y$,D:=$DIA$,T:=-$T$,TLF:=10,AXISDW:=0)

elseif $DIA$=15.1
\\ 15.1 Löschen

elseif $CLAMEXWV$=0
;HH_Cabineo FLAECHE kante2 LI
CALL CABINEO_HH ( VAL POS_X:=0,POS_Y:=$Y$,TIEFE:=-$T$,SEITE:=2,TYP:=0,WINKEL:=0,FLAECHE:=0)

elseif $CLAMEXWV$=90
;HH_Cabineo FLAECHE kante1 VO
CALL CABINEO_HH ( VAL POS_X:=$X$,POS_Y:=0,TIEFE:=-$T$,SEITE:=1,TYP:=0,WINKEL:=0,FLAECHE:=0)

elseif $CLAMEXWV$=180
;HH_Cabineo FLAECHE kante4 Re
