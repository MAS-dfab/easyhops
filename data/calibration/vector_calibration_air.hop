;MAKROTYP=0
;INFO=easyhops vector milling calibration
;WZGV=7235C_219
;MASCHINE=Holzher
;NCNAME=vector_calibration_air
;KOMMENTAR=
;DIALOGDLL=Dialoge.Dll
;DIALOGPROC=StandardFormAnzeigen
;AUTOSCRIPTSTART=1
;BUTTONBILD=
;DIMENSION_UNIT=0

VARS
   DX := 500.0;*VAR* Piece Length
   DY := 200.0;*VAR* Piece Height
   DZ := 100.0;*VAR* Piece Thickness
START

FERTIGTEIL(DX,DY,DZ,0,0,0.000,0.000,0.000,'',0,0,0)

CALL Park_V7 ( VAL MODE:=11,POSX:=0,POSY:=0)

; ---------------------------------
;Pass 1: vertical tool (DW 0, KW 0) on the TOP face
; ---------------------------------
; Expect: groove along X from X=40 to X=140 at Y=50, 2 mm deep, near the X=0/Y=0 corner
WZF(404,_VE,_V,_VA,_SD,_ANF,'1')
VSP (40,50,143,0,0,0,0,0,0,3,1,0,0)
VG01 (40,50,143,0,0,5000)
VG01 (40,50,128,0,0,1000)
VG01 (60,50,128,0,0,2000)
VG01 (80,50,128,0,0,2000)
VG01 (100,50,128,0,0,2000)
VG01 (120,50,128,0,0,2000)
VG01 (140,50,128,0,0,2000)
VG01 (140,50,143,0,0,5000)
VEP (0)

; ---------------------------------
;Pass 2: constant tilt KW 30, DW 0 on the TOP face
; ---------------------------------
; Expect: groove along X at Y=150; spindle leans towards Y=0 (the -Y face)
WZF(404,_VE,_V,_VA,_SD,_ANF,'1')
VSP (40,127.5,136.971,0,30,0,0,0,0,3,1,0,0)
VG01 (40,127.5,136.971,0,30,5000)
VG01 (40,135,123.981,0,30,1000)
VG01 (60,135,123.981,0,30,2000)
VG01 (80,135,123.981,0,30,2000)
VG01 (100,135,123.981,0,30,2000)
VG01 (120,135,123.981,0,30,2000)
VG01 (140,135,123.981,0,30,2000)
VG01 (140,127.5,136.971,0,30,5000)
VEP (0)

; ---------------------------------
;Pass 3: tilt sweep KW 0 -> 45 (DW 0) on the TOP face
; ---------------------------------
; Expect: one continuous groove X=200..290 at Y=100, tool tilting smoothly towards -Y, no stop
WZF(404,_VE,_V,_VA,_SD,_ANF,'1')
VSP (200,100,143,0,0,0,0,0,0,3,1,0,0)
VG01 (200,100,143,0,0,5000)
VG01 (200,100,128,0,0,1000)
VG01 (210,97.385,127.886,0,5,2000)
VG01 (220,94.791,127.544,0,10,2000)
VG01 (230,92.235,126.978,0,15,2000)
VG01 (240,89.739,126.191,0,20,2000)
VG01 (250,87.321,125.189,0,25,2000)
VG01 (260,85,123.981,0,30,2000)
VG01 (270,82.793,122.575,0,35,2000)
VG01 (280,80.716,120.981,0,40,2000)
VG01 (290,78.787,119.213,0,45,2000)
VG01 (290,68.18,129.82,0,45,5000)
VEP (0)

; ---------------------------------
;Pass 4: tool-tip test IN THE AIR at X=400 Y=100 Z=DZ+30
; ---------------------------------
; Expect: tip stays on one point while KW goes 0->30 and DW 0->180->0 (no cutting)
WZF(404,_VE,_V,_VA,_SD,_ANF,'1')
VSP (400,100,160,0,0,0,0,0,0,3,1,0,0)
VG01 (400,100,160,0,0,2000)
VG01 (400,100,160,0,5,2000)
VG01 (400,100,160,0,10,2000)
VG01 (400,100,160,0,15,2000)
VG01 (400,100,160,0,20,2000)
VG01 (400,100,160,0,25,2000)
VG01 (400,100,160,0,30,2000)
VG01 (400,100,160,15,30,2000)
VG01 (400,100,160,30,30,2000)
VG01 (400,100,160,45,30,2000)
VG01 (400,100,160,60,30,2000)
VG01 (400,100,160,75,30,2000)
VG01 (400,100,160,90,30,2000)
VG01 (400,100,160,105,30,2000)
VG01 (400,100,160,120,30,2000)
VG01 (400,100,160,135,30,2000)
VG01 (400,100,160,150,30,2000)
VG01 (400,100,160,165,30,2000)
VG01 (400,100,160,180,30,2000)
VG01 (400,100,160,165,30,2000)
VG01 (400,100,160,150,30,2000)
VG01 (400,100,160,135,30,2000)
VG01 (400,100,160,120,30,2000)
VG01 (400,100,160,105,30,2000)
VG01 (400,100,160,90,30,2000)
VG01 (400,100,160,75,30,2000)
VG01 (400,100,160,60,30,2000)
VG01 (400,100,160,45,30,2000)
VG01 (400,100,160,30,30,2000)
VG01 (400,100,160,15,30,2000)
VG01 (400,100,160,0,30,2000)
VEP (0)

; ---------------------------------
;Pass 5: horizontal tool (DW 0, KW 90) on the FRONT face Y=0
; ---------------------------------
; Expect: groove along X at Z=50 on the Y=0 face, spindle outside the part on the -Y side
WZF(404,_VE,_V,_VA,_SD,_ANF,'1')
VSP (40,-43,50,0,90,0,0,0,0,3,1,0,0)
VG01 (40,-43,50,0,90,5000)
VG01 (40,-28,50,0,90,1000)
VG01 (60,-28,50,0,90,2000)
VG01 (80,-28,50,0,90,2000)
VG01 (100,-28,50,0,90,2000)
VG01 (120,-28,50,0,90,2000)
VG01 (140,-28,50,0,90,2000)
VG01 (140,-43,50,0,90,5000)
VEP (0)

; ---------------------------------
;Pass 6: horizontal tool on the FRONT face, DW turning 10 -> 30 (KW 90)
; ---------------------------------
; Expect: groove along X at Z=50, spindle swinging continuously towards +X
WZF(404,_VE,_V,_VA,_SD,_ANF,'1')
VSP (207.814,-42.316,50,10,90,0,0,0,0,3,1,0,0)
VG01 (207.814,-42.316,50,10,90,5000)
VG01 (205.209,-27.544,50,10,90,1000)
VG01 (222.258,-27.109,50,14,90,2000)
VG01 (239.271,-26.532,50,18,90,2000)
VG01 (256.238,-25.816,50,22,90,2000)
VG01 (273.151,-24.964,50,26,90,2000)
VG01 (290,-23.981,50,30,90,2000)
VG01 (297.5,-36.971,50,30,90,5000)
VEP (0)

; ---------------------------------
;Pass 7: horizontal tool on the BACK face Y=DY, DW turning 170 -> 150 (KW 90)
; ---------------------------------
; Expect: mirror of pass 6 on the opposite face
WZF(404,_VE,_V,_VA,_SD,_ANF,'1')
VSP (207.814,242.316,50,170,90,0,0,0,0,3,1,0,0)
VG01 (207.814,242.316,50,170,90,5000)
VG01 (205.209,227.544,50,170,90,1000)
VG01 (222.258,227.109,50,166,90,2000)
VG01 (239.271,226.532,50,162,90,2000)
VG01 (256.238,225.816,50,158,90,2000)
VG01 (273.151,224.964,50,154,90,2000)
VG01 (290,223.981,50,150,90,2000)
VG01 (297.5,236.971,50,150,90,5000)
VEP (0)
